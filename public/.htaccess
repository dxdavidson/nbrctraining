# NBRC Training SPA, deployed at /training/
RewriteEngine On
RewriteBase /training/

# Let Apache serve images, JavaScript, CSS, and other real files directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send client-side application routes to the Vite entry point.
RewriteRule ^ index.html [L]
